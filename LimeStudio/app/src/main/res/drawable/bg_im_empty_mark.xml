<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded tile behind the empty-IM-list keyboard glyph. A soft tint of the
     primary (Material You secondary-container analogue) so the green glyph reads
     clearly. Mirrors the .empty-mark tile in the lime-settings-android
     im-empty-state-demo.html. See docs/LIME_SETTINGS.md §5.1.1. -->
<!-- Soft accent-tinted tile behind the keyboard glyph. im_empty_mark_background
     is day/night aware (see values/ and values-night/colors.xml) so it reads on
     both light and dark surfaces. Mirrors the demo's .empty-mark container. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/im_empty_mark_background" />
    <corners android:radius="28dp" />
</shape>
