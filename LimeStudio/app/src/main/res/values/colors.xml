    <!-- Material blue for links and UI accent (tabs, FAB, buttons) -->
    <color name="material_blue">#FF2196F3</color>

    <!-- Lime green for switches and secondary accents — matches iOS LIME brand color -->
    <color name="lime_green">#FF4CAF50</color>

    <!-- IM list-row leading badge: neutral grey circle carrying the IM's
         representative character (systemGray / #8E8E93). Identical to iOS;
         accent colour is reserved for interactive controls. -->
    <color name="im_badge_background">#FF8E8E93</color>
    <color name="im_badge_foreground">#FFFFFFFF</color>

    <!-- Empty-IM-list keyboard-glyph tile (§5.1.1). A soft tint of the blue
         accent behind the ?attr/colorPrimary glyph (matches the demo's
         secondary-container .empty-mark, adapted to the app's blue accent).
         Day value: ~12% blue over white. Dark variant in values-night. -->
    <color name="im_empty_mark_background">#FFE3F0FB</color>

    <!-- Status-banner subtle tints — TRANSLUCENT versions of each status colour
         so they read as a faint wash over whatever surface is behind them and
         adapt to light/dark (a dark override is in values-night). The banner
         shows the status glyph + text in the ink colour over the matching tint. -->
    <color name="status_tint_green">#1F2E7D32</color>
    <color name="status_tint_yellow">#1FEF6C00</color>
    <color name="status_tint_red">#1FC62828</color>

    <!-- Bordered-button tinted fill (design Button "bordered": 12% of the tint
         colour, no outline). Green for normal, red for destructive. -->
    <color name="button_tint_green">#1F009444</color>
    <color name="button_tint_red">#1FFF3B30</color>

